  "note": "map_position 회귀 케이스. expected는 원본 A 좌표다. opcode별로 묶었다.",
  "cases": [
    {"name": "equal_start",      "opcode": "equal",   "w": "가나다",     "a": "가나다",     "pos_w": 0, "expected": 0},
    {"name": "equal_middle",     "opcode": "equal",   "w": "가나다",     "a": "가나다",     "pos_w": 1, "expected": 1},
    {"name": "equal_end",        "opcode": "equal",   "w": "가나다",     "a": "가나다",     "pos_w": 3, "expected": 3},
    {"name": "equal_single",     "opcode": "equal",   "w": "가",        "a": "가",        "pos_w": 1, "expected": 1},

    {"name": "replace_same_len", "opcode": "replace", "w": "가나다",     "a": "가라다",     "pos_w": 2, "expected": 2},
    {"name": "replace_w_longer", "opcode": "replace", "w": "가나다라마",  "a": "가바라마",   "pos_w": 3, "expected": 2},
    {"name": "replace_a_longer", "opcode": "replace", "w": "가나마",     "a": "가바다라마",  "pos_w": 2, "expected": 4},
    {"name": "replace_whole",    "opcode": "replace", "w": "가나다",     "a": "바사아",     "pos_w": 2, "expected": 2},

    {"name": "insert_middle",    "opcode": "insert",  "w": "가나",       "a": "가바나",     "pos_w": 1, "expected": 2},
    {"name": "insert_end",       "opcode": "insert",  "w": "가나",       "a": "가나바",     "pos_w": 2, "expected": 3},

    {"name": "delete_middle",    "opcode": "delete",  "w": "가바나",     "a": "가나",      "pos_w": 2, "expected": 1},
    {"name": "delete_end",       "opcode": "delete",  "w": "가나바",     "a": "가나",      "pos_w": 2, "expected": 2},

    {"name": "boundary_zero",    "opcode": "equal",   "w": "가나다",     "a": "가나다",     "pos_w": 0, "expected": 0},
    {"name": "boundary_len",     "opcode": "equal",   "w": "가나다",     "a": "가나다",     "pos_w": 3, "expected": 3},
    {"name": "empty_w",          "opcode": "insert",  "w": "",          "a": "가나다",     "pos_w": 0, "expected": 0},
    {"name": "empty_a",          "opcode": "delete",  "w": "가나다",     "a": "",          "pos_w": 2, "expected": 0}
