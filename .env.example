# ============================================================
#  vlogsrt 환경 설정
# ------------------------------------------------------------
#  1. 이 파일을 .env 로 복사하세요.
#         cp .env.example .env
#  2. OPENAI_API_KEY 값을 채우세요.
#  3. .env 는 .gitignore 에 있습니다. 커밋되지 않습니다.
#
#  ⚠️  .env 는 Claude Code 가 읽을 수 없도록
#      .claude/settings.json 에서 deny 되어 있습니다.
#      키가 대화 컨텍스트에 들어가는 것을 막기 위함입니다.
# ============================================================


# ─── OpenAI ────────────────────────────────────────────────
# https://platform.openai.com/api-keys 에서 발급
# 실제 API 호출이 필요한 경우에만 사용됩니다:
#   - vlogsrt record   (픽스처 녹화)
#   - vlogsrt run --online
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 프록시나 호환 엔드포인트를 쓸 때만 설정. 보통은 비워둡니다.
# OPENAI_BASE_URL=


# ─── 오프라인 모드 (중요) ───────────────────────────────────
# 1  = 픽스처(tests/fixtures/api/)만 사용. API 호출 없음. 무료.
# 0  = 실제 API 호출. 유료.
#
# 개발 중에는 반드시 1 로 둡니다.
# Claude Code 가 반복 실행하기 때문에, 0 이면 비용이 폭발합니다.
# 실제 호출은 `vlogsrt record` 또는 `vlogsrt run --online` 으로만 하세요.
# (두 커맨드는 이 값과 무관하게 동작하며, 실행 전 확인을 요구합니다.)
VLOGSRT_OFFLINE=1


# ─── 경로 ──────────────────────────────────────────────────
VLOGSRT_FIXTURE_DIR=tests/fixtures/api
VLOGSRT_WORK_DIR=.vlogsrt-cache
VLOGSRT_GOLDEN_DIR=golden


# ─── 실행 ──────────────────────────────────────────────────
# DEBUG | INFO | WARNING | ERROR
VLOGSRT_LOG_LEVEL=INFO

# 기본 프리셋: vlog | shorts | lecture
VLOGSRT_PRESET=vlog

# 병렬 호출 워커 수 (청크 × 2 모델)
VLOGSRT_MAX_WORKERS=8


# ─── 비용 안전장치 ─────────────────────────────────────────
# 1회 실행에서 이 시간(초)을 넘는 오디오면 확인을 요구합니다.
# 3600 = 1시간. 실수로 장편을 돌리는 것을 막습니다.
VLOGSRT_COST_GUARD_SECONDS=3600
